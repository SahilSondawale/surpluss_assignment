# Copy to .env for local development (npm run start:dev / start:worker).
# In Docker these come from docker-compose.yml instead.

PORT=4000
DATABASE_URL=postgres://webhook:webhook@localhost:5432/webhooks

# Worker settings (optional: these are the defaults)
# WORKER_ID=worker-1
WORKER_CONCURRENCY=2
LEASE_SECONDS=30
MAX_ATTEMPTS=5
RETRY_BASE_DELAY_MS=1000
RETRY_MAX_DELAY_MS=30000
POLL_INTERVAL_MS=500

# Integration tests use their own database (created automatically)
TEST_DATABASE_URL=postgres://webhook:webhook@localhost:5432/webhooks_test
